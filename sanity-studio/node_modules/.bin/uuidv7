#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/Users/elmabichara/site-ileala-oficial/sanity-studio/node_modules/uuidv7/node_modules:/Users/elmabichara/site-ileala-oficial/sanity-studio/node_modules:/Users/elmabichara/site-ileala-oficial/node_modules:/Users/elmabichara/node_modules:/Users/node_modules:/node_modules:/Users/elmabichara/site-ileala-oficial/sanity-studio/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/Users/elmabichara/site-ileala-oficial/sanity-studio/node_modules/uuidv7/node_modules:/Users/elmabichara/site-ileala-oficial/sanity-studio/node_modules:/Users/elmabichara/site-ileala-oficial/node_modules:/Users/elmabichara/node_modules:/Users/node_modules:/node_modules:/Users/elmabichara/site-ileala-oficial/sanity-studio/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../uuidv7/cli.js" "$@"
else
  exec node  "$basedir/../uuidv7/cli.js" "$@"
fi
